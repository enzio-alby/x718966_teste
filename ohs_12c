# ─── JAVA 8 SO ───────────────────────────────────────────────────────────────
# DIFERENCA vs 14.1.2: usa JDK 8 (nao 17/21). java.security em jre/lib/security/

instalar_java() {
    log_step "Fase 0 - Instalacao / Atualizacao do Java 8 SO"

    echo ""
    echo "  Versoes de Java instaladas atualmente:"
    rpm -qa | grep jdk || echo "  (nenhuma)"
    echo ""

    if rpm -qa | grep -q "jdk-8u"; then
        log_ok "Java 8 ja detectado no sistema."
        JAVA_HOME_PATH=$(rpm -ql $(rpm -qa | grep jdk-8u | head -1) 2>/dev/null | grep "^/usr/java" | head -1 | xargs dirname | xargs dirname 2>/dev/null || echo "$JAVA_HOME_8A")
        read -rp "  Deseja reinstalar/atualizar o Java 8? (s/n): " troca_java
        if [[ "$troca_java" != "s" ]]; then
            log_info "Mantendo Java 8 atual: $JAVA_HOME_PATH"
            _configurar_java_security
            return 0
        fi
    fi

    # Java RPM vem bundlado dentro do CPU tar.gz em latest/java/jdk-8u*.rpm.
    # Baixa o tar.gz do CPU (se ainda nao baixado) e instala via _update_java_cpu.
    log_info "Java RPM esta bundlado no CPU tar.gz. Baixando pacote CPU para extrair..."
    baixar_pacote_psu
    _update_java_cpu
}

_configurar_java_security() {
    # JDK 8: java.security em jre/lib/security/ (diferente do JDK 17+ que usa conf/security/)
    local jsec="${JAVA_HOME_PATH}/jre/lib/security/java.security"
    if [ -f "$jsec" ]; then
        sed -i 's|securerandom.source=file:/dev/random|securerandom.source=file:/dev/./urandom|' "$jsec"
        log_ok "java.security configurado para urandom: $jsec"
    else
        log_warn "java.security nao encontrado em: $jsec"
        log_warn "Verifique se o JAVA_HOME_PATH esta correto: $JAVA_HOME_PATH"
    fi
}

# ─── DOWNLOAD DO INSTALADOR OHS ──────────────────────────────────────────────
# Standalone: apenas o ZIP do OHS. Sem FMW Infrastructure JAR.

baixar_instaladores() {
    log_step "Fase 1a - Download do Instalador OHS 12.2.1.4 Standalone"

    local ohs_dir="${MIDIAS}/instaladores_ohs12214"
    local tar_gz="instaladores.tar.gz"
    mkdir -p "$ohs_dir"
    chown oracle:oinstall "$ohs_dir"

    cd "$ohs_dir" || { log_erro "Falha ao acessar $ohs_dir"; exit 1; }

    # Reutilizar binario ja extraido de execucao anterior
    if [ -f "${BIN_OHS}" ]; then
        log_warn "${BIN_OHS} ja existe em $ohs_dir. Pulando download."
    else
        # Baixar tar.gz se nao presente (contem todos os instaladores 12214)
        if [ -f "$tar_gz" ]; then
            log_warn "$tar_gz ja existe em $ohs_dir. Reaproveitando."
        else
            log_info "Baixando $tar_gz de: $REPO_INSTALADORES"
            sudo -u oracle wget -q --show-progress "$REPO_INSTALADORES" -O "$tar_gz"
            checar_erro "Falha no download de $tar_gz."
        fi

        log_info "Extraindo $tar_gz (estrutura: instaladores/ohs/<zip>)..."
        sudo -u oracle tar -xf "$tar_gz"
        checar_erro "Falha ao extrair $tar_gz."

        local zip_path="instaladores/ohs/${ZIP_OHS}"
        if [ ! -f "$zip_path" ]; then
            log_erro "ZIP nao encontrado em: ${ohs_dir}/${zip_path}"
            log_erro "Verifique a estrutura do $tar_gz no repositorio."
            exit 1
        fi

        log_info "Descompactando ${ZIP_OHS}..."
        sudo -u oracle unzip -q -o "$zip_path"
        checar_erro "Falha ao descompactar $ZIP_OHS."
    fi

    chown -R oracle:oinstall "$ohs_dir"
    chmod -R 750 "$ohs_dir"

    if [ -f "${BIN_OHS}" ]; then
        log_ok "Binario encontrado: ${ohs_dir}/${BIN_OHS}"
    else
        log_erro "Binario $BIN_OHS nao encontrado em $ohs_dir apos descompactar $ZIP_OHS."
        log_erro "Verifique o conteudo do ZIP no repositorio."
        exit 1
    fi
}

# ─── RESPONSE FILE DO INSTALADOR ─────────────────────────────────────────────

gerar_response_files() {
    local rsp_dir="${MIDIAS}/response"
    mkdir -p "$rsp_dir"
    chown -R ${ORACLE_USER}:${ORACLE_GROUP} "$rsp_dir"

    # Standalone: INSTALL_TYPE = "Standalone HTTP Server (Managed independently of WebLogic server)"
    # Ref: Oracle Doc wtins/installing-product-software - Tabela 3-1, campo Installation Type
    cat > "${rsp_dir}/ohs.rsp" << EOF
[ENGINE]
Response File Version=1.0.0.0.0
[GENERIC]
ORACLE_HOME=${ORACLE_HOME}
INSTALL_TYPE=Standalone HTTP Server (Managed independently of WebLogic server)
DECLINE_SECURITY_UPDATES=true
SECURITY_UPDATES_VIA_MYORACLESUPPORT=false
EOF

    chown ${ORACLE_USER}:${ORACLE_GROUP} "${rsp_dir}/ohs.rsp"
    log_ok "Response file gerado: ${rsp_dir}/ohs.rsp"
    log_info "  INSTALL_TYPE: Standalone HTTP Server (Managed independently of WebLogic server)"
}

# ─── INSTALAÇÃO DOS BINÁRIOS OHS ─────────────────────────────────────────────
# Standalone puro: apenas o OHS bin. O installer cria oracle_common com WLST.

instalar_binarios() {
    log_step "Fase 1 - Instalação do Oracle HTTP Server 12.2.1.4 Standalone"

    local ohs_dir="${MIDIAS}/instaladores_ohs12214"
    local rsp_dir="${MIDIAS}/response"

    [[ -z "$JAVA_HOME_PATH" ]] && JAVA_HOME_PATH="$JAVA_HOME_8A"
    JAVA_BIN="${JAVA_HOME_PATH}/bin/java"
    if [ ! -x "$JAVA_BIN" ]; then
        JAVA_BIN=$(find /usr/java -name "java" -type f 2>/dev/null | head -1)
    fi
    [[ -z "$JAVA_BIN" ]] && { log_erro "Java nao encontrado. Execute a opcao [2] primeiro."; exit 1; }
    log_info "Usando Java: $JAVA_BIN"
    export JAVA_HOME=$(dirname $(dirname "$JAVA_BIN"))

    criar_orainst
    gerar_response_files

    if [ -d "${ORACLE_HOME}/ohs" ]; then
        log_ok "OHS ja detectado em ${ORACLE_HOME}/ohs. Pulando instalacao."
    else
        log_step "Instalando Oracle HTTP Server 12.2.1.4.0 Standalone"

        if [ ! -f "${ohs_dir}/${BIN_OHS}" ]; then
            log_erro "Binario $BIN_OHS nao encontrado em $ohs_dir."
            log_erro "Execute a opcao [3] (Download + Instalar) ou verifique o repositorio."
            exit 1
        fi

        chmod +x "${ohs_dir}/${BIN_OHS}"

        log_info "Instalando OHS 12.2.1.4 Standalone silenciosamente..."
        log_info "Comando: ${BIN_OHS} -silent -ignoreSysPrereqs -responseFile ohs.rsp"
        sudo -u oracle "${ohs_dir}/${BIN_OHS}" \
            -silent \
            -ignoreSysPrereqs \
            -responseFile "${rsp_dir}/ohs.rsp" \
            -invPtrLoc "$ORAINST" \
            -jreLoc "$JAVA_HOME" \
            2>&1 | tee -a "$LOGFILE"
        checar_erro "Falha na instalacao do OHS."

        # Validacao: OHS dir
        if [ -d "${ORACLE_HOME}/ohs" ]; then
            log_ok "Validacao OK: ${ORACLE_HOME}/ohs existe."
        else
            log_erro "Validacao FALHOU: diretorio ohs nao encontrado apos instalacao."
            exit 1
        fi

        # Validacao: oracle_common/wlst.sh (criado pelo installer standalone)
        # Ref: Doc Oracle - config.sh fica em ORACLE_HOME/oracle_common/common/bin/
        if [ -f "${ORACLE_HOME}/oracle_common/common/bin/wlst.sh" ]; then
            log_ok "Validacao OK: oracle_common/wlst.sh presente (standalone installer criou oracle_common)."
        else
            log_warn "wlst.sh nao encontrado ainda em oracle_common — pode ser timing. Verifique apos install completo."
        fi

        log_ok "OHS 12.2.1.4 Standalone instalado com sucesso."
    fi

    # Upgrade do oracle_common/jdk (especifico do 12.2.1.4 — nao necessario no 14.1.2)
    # O FMW 12.2.1.4 embute JDK 8 antigo em oracle_common/jdk; precisa ser substituido.
    _upgrade_oracle_common_jdk

    log_ok "Instalacao de binarios concluida em: $ORACLE_HOME"
}

_upgrade_oracle_common_jdk() {
    log_step "Fase 1b - Upgrade do oracle_common/jdk (especifico 12.2.1.4)"

    local oc_dir="${ORACLE_HOME}/oracle_common"
    local oc_jdk="${oc_dir}/jdk"
    local javaoc_dir="${MIDIAS}/javaoc"

    if [[ -z "$ORACLE_HOME" || "$oc_jdk" == "/" || "$oc_jdk" == "/jdk" ]]; then
        log_erro "ORACLE_HOME invalido. Abortando upgrade do oracle_common/jdk."
        exit 1
    fi

    if [ ! -d "$oc_dir" ]; then
        log_warn "Diretorio oracle_common nao encontrado. Pulando upgrade do JDK."
        return 0
    fi

    # Idempotencia: ja e JDK 8u501?
    if [ -x "${oc_jdk}/bin/java" ] && "${oc_jdk}/bin/java" -version 2>&1 | grep -q "1.8.0_501"; then
        log_ok "oracle_common/jdk ja e JDK 8u501. Pulando upgrade (idempotente)."
        return 0
    fi

    log_info "JDK atual em oracle_common/jdk:"
    if [ -x "${oc_jdk}/bin/java" ]; then
        "${oc_jdk}/bin/java" -version 2>&1 | tee -a "$LOGFILE"
    else
        log_warn "oracle_common/jdk sem JDK instalado ainda (sera substituido)."
    fi

    # oracle_common usa ZIP separado com TAR.GZ (diferente do RPM do SO)
    log_info "Baixando JDK para oracle_common: $REPO_OC_JDK"
    mkdir -p "$javaoc_dir"
    chown oracle:oinstall "$javaoc_dir"

    cd "$javaoc_dir" || { log_erro "Falha ao acessar $javaoc_dir"; exit 1; }
    if [ -f "jdk_501.zip" ]; then
        log_warn "jdk_501.zip ja existe em $javaoc_dir. Reaproveitando."
    else
        sudo -u oracle wget -q --show-progress "$REPO_OC_JDK" -O "jdk_501.zip"
        checar_erro "Falha no download do JDK para oracle_common."
    fi

    log_info "Descompactando jdk_501.zip (contem tar.gz)..."
    sudo -u oracle unzip -q -o "jdk_501.zip"
    checar_erro "Falha ao descompactar jdk_491.zip."

    local jdk_tar
    jdk_tar=$(find "$javaoc_dir" -maxdepth 1 -name "jdk-8u*.tar.gz" | head -1)
    if [ -z "$jdk_tar" ]; then
        log_erro "tar.gz do JDK nao encontrado em $javaoc_dir apos unzip."
        exit 1
    fi

    log_info "Extraindo: $(basename "$jdk_tar")"
    sudo -u oracle tar -xf "$jdk_tar" -C "$javaoc_dir"
    checar_erro "Falha ao extrair tar.gz do JDK."

    local jdk_dir jdk_basename
    jdk_dir=$(find "$javaoc_dir" -maxdepth 1 -type d -name "jdk1.8.0*" | head -1)
    if [ -z "$jdk_dir" ]; then
        log_erro "Diretorio jdk1.8.0_* nao encontrado apos extracao."
        exit 1
    fi
    jdk_basename=$(basename "$jdk_dir")
    log_ok "JDK extraido: $jdk_basename"

    mv "$jdk_dir" "${oc_dir}/"
    checar_erro "Falha ao mover $jdk_basename para $oc_dir."

    log_info "Fazendo backup de oracle_common/jdk..."
    sudo -u oracle tar -zcf "${oc_dir}/jdk_OCbkp.tar.gz" -C "$oc_dir" "jdk" 2>/dev/null || true
    log_ok "Backup salvo: ${oc_dir}/jdk_OCbkp.tar.gz"

    rm -rf "${oc_jdk}"
    checar_erro "Falha ao remover oracle_common/jdk antigo."

    cd "$oc_dir" || { log_erro "Falha ao acessar $oc_dir"; exit 1; }
    mv "$jdk_basename" "jdk"
    checar_erro "Falha ao renomear ${jdk_basename} para jdk em $oc_dir."

    chown -R oracle:oinstall "${oc_jdk}"

    if [ ! -x "${oc_jdk}/bin/java" ]; then
        log_erro "oracle_common/jdk/bin/java nao encontrado apos upgrade."
        exit 1
    fi

    log_info "JDK pos-upgrade em oracle_common/jdk:"
    "${oc_jdk}/bin/java" -version 2>&1 | tee -a "$LOGFILE" || true
    log_ok "oracle_common/jdk atualizado com sucesso."

    rm -rf "$javaoc_dir"
}

# ─── CPU OHS 12.2.1.4 JUL 2026 ───────────────────────────────────────────────
# Logica extraida de OHS_12214_JUL26.sh (producao Getnet):
#   1. patch_storage_pre   : restaurar .patch_storage (se existir backup)
#   2. baixar_pacote_psu   : download 12.2.1.4.0_19c.tar.gz (Java + OPatch + 14 patches)
#   3. _update_java_cpu    : atualizar Java SO pelo RPM bundlado
#   4. upgrade_opatch      : OPatch 6880880 via opatch_generic.jar
#   5. aplicar_patches_ohs : 14 patches CPU via opatch apply
#   6. patch_storage_final : compactar e limpar .patch_storage
#   7. update_globalenv    : JAVA_HOME + JAVA_HOME_1_8 = /usr/java/latest (3x sleep 15)
#   8. _upgrade_oracle_common_jdk: oracle_common/jdk atualizado com jdk_501.zip

baixar_pacote_psu() {
    log_step "Fase 2a - Download Pacote CPU OHS 12.2.1.4 JUL 2026"

    local psu_dir="${MIDIAS}/OHS"
    local psu_tar="12.2.1.4.0_19c.tar.gz"

    log_info "URL: $REPO_PSU_OHS_TAR"

    mkdir -p "$psu_dir"
    chown -R oracle: "$psu_dir"

    cd "$psu_dir" || { log_erro "Falha ao acessar $psu_dir"; exit 1; }

    if [ -f "$psu_tar" ]; then
        log_warn "Arquivo $psu_tar ja existe em $psu_dir. Reaproveitando."
    else
        log_info "Baixando CPU OHS 12.2.1.4 JUL 2026..."
        sudo -u oracle wget -q --show-progress "$REPO_PSU_OHS_TAR" -O "$psu_tar"
        checar_erro "Falha no download do pacote CPU OHS."
    fi

    if [ ! -d "${psu_dir}/latest" ]; then
        log_info "Extraindo $psu_tar..."
        sudo -u oracle tar -xf "$psu_tar"
        checar_erro "Falha ao extrair $psu_tar."
        log_ok "CPU extraido em: ${psu_dir}/latest"
    else
        log_warn "Diretorio ${psu_dir}/latest ja existe. Pulando extracao."
    fi

    for check_d in "${psu_dir}/latest/java" "${psu_dir}/latest/jarpatch" "${psu_dir}/latest/opatch"; do
        if [ -d "$check_d" ]; then
            log_ok "OK: $check_d"
        else
            log_warn "NAO encontrado: $check_d (verifique conteudo do tar.gz)"
        fi
    done
}

_update_java_cpu() {
    local java_cpu_dir="${MIDIAS}/OHS/latest/java"

    if [ ! -d "$java_cpu_dir" ]; then
        log_warn "Diretorio java do CPU nao encontrado: $java_cpu_dir. Pulando update Java SO."
        return 0
    fi

    local java_rpm
    java_rpm=$(find "$java_cpu_dir" -maxdepth 1 -name "jdk-8u*.rpm" | head -1)
    if [ -z "$java_rpm" ]; then
        log_warn "RPM Java nao encontrado em $java_cpu_dir. Pulando update Java SO."
        return 0
    fi

    log_info "Java RPM bundlado no CPU: $(basename "$java_rpm")"

    read -rp "  Versao Java a REMOVER antes de atualizar (Enter para pular): " java_remove
    if [ -n "$java_remove" ]; then
        if rpm -qa | grep -q "$java_remove"; then
            rpm -e --nodeps "$java_remove"
            log_ok "Java $java_remove removido."
        else
            log_warn "Versao '$java_remove' nao encontrada. Pulando remocao."
        fi
    fi

    log_info "Instalando $(basename "$java_rpm") do bundle CPU..."
    rpm -i --replacepkgs "$java_rpm" || rpm -U "$java_rpm" || true
    log_ok "Java SO atualizado."

    if [ -L "/usr/java/latest" ]; then
        JAVA_HOME_PATH="/usr/java/latest"
        log_ok "/usr/java/latest -> $(readlink /usr/java/latest)"
    else
        JAVA_HOME_PATH=$(find /usr/java /usr/lib/jvm -maxdepth 1 -name "jdk1.8*" -o -name "jdk-1.8*" 2>/dev/null | head -1)
        log_warn "/usr/java/latest nao e symlink. Usando: $JAVA_HOME_PATH"
    fi

    _configurar_java_security
}

upgrade_opatch() {
    log_step "Fase 2b - Atualização do OPatch"

    local opatch_dir="${MIDIAS}/OHS/latest/jarpatch"

    log_info "OPatch atual:"
    sudo -u oracle "$ORACLE_HOME/OPatch/opatch" version 2>&1 | tee -a "$LOGFILE" || true

    if [ ! -d "$opatch_dir" ]; then
        log_erro "Diretorio jarpatch nao encontrado: $opatch_dir"
        log_erro "Execute a Fase 2a (baixar_pacote_psu) primeiro."
        exit 1
    fi

    log_info "Descompactando OPatch (6880880) em $opatch_dir..."
    cd "$opatch_dir" || { log_erro "Falha ao acessar $opatch_dir"; exit 1; }
    sudo -u oracle unzip -q -o "*.zip"
    checar_erro "Falha ao descompactar zip do OPatch."

    if [ ! -f "${opatch_dir}/6880880/opatch_generic.jar" ]; then
        log_erro "opatch_generic.jar nao encontrado em ${opatch_dir}/6880880"
        exit 1
    fi

    log_info "Atualizando OPatch em: $ORACLE_HOME"
    cd "${opatch_dir}/6880880" || { log_erro "Falha ao acessar ${opatch_dir}/6880880"; exit 1; }
    sudo -u oracle java -jar opatch_generic.jar -silent oracle_home="$ORACLE_HOME"
    checar_erro "Falha na atualizacao do OPatch."

    log_info "OPatch pos-upgrade:"
    sudo -u oracle "$ORACLE_HOME/OPatch/opatch" version 2>&1 | tee -a "$LOGFILE" || true
    log_ok "OPatch atualizado com sucesso."
}

aplicar_patches_ohs() {
    log_step "Fase 2c - Aplicação dos 14 Patches CPU JUL 2026 OHS 12.2.1.4"

    local patches=(
        # 14 patches CPU JUL 2026 (todos presentes no bundle Getnet)
        "39638312" "39611663" "39567777" "39425385" "39574504"
        "39487427" "39246821" "39465265" "39114058" "38590502"
        "38098858" "38832179" "37056593" "36789759"
    )

    local opatch_dir="${MIDIAS}/OHS/latest/opatch"

    if [ ! -d "$opatch_dir" ]; then
        log_erro "Diretorio de patches nao encontrado: $opatch_dir"
        log_erro "Execute a Fase 2a (baixar_pacote_psu) primeiro."
        exit 1
    fi

    # OPatch precisa que oracle seja dono do launch antes de aplicar patches
    log_info "Ajustando propriedade do launch para oracle (pre-patch)..."
    chown oracle: "$ORACLE_HOME/ohs/bin/launch" 2>/dev/null || true

    # Pre-extrair todos os ZIPs do Oracle (formato: p{ID}_{VER}_{PLAT}.zip)
    log_info "Pre-extraindo todos os patches do opatch/..."
    for zip_file in "${opatch_dir}"/p*.zip; do
        [ -f "$zip_file" ] || continue
        sudo -u oracle unzip -q -o "$zip_file" -d "$opatch_dir"
    done
    log_ok "Patches extraidos em: $opatch_dir"

    local total=${#patches[@]}
    local i=0
    for patch_id in "${patches[@]}"; do
        i=$((i+1))
        log_info "Aplicando patch [$i/$total]: $patch_id"
        local patch_path="${opatch_dir}/${patch_id}"

        if [ ! -d "$patch_path" ]; then
            log_erro "Patch $patch_id nao encontrado em $opatch_dir apos extracao. Verifique o tar.gz."
            exit 1
        fi

        sudo -u oracle "$ORACLE_HOME/OPatch/opatch" apply \
            -silent -oh "$ORACLE_HOME" "$patch_path" \
            2>&1 | tee -a "$LOGFILE"

        local opatch_rc=${PIPESTATUS[0]}
        if [ $opatch_rc -eq 73 ]; then
            # Exit 73: componente do patch nao instalado neste OH (ex: DBClient 19c em OHS standalone)
            log_warn "Patch $patch_id ignorado — componente nao presente neste ORACLE_HOME (exit 73)."
        elif [ $opatch_rc -ne 0 ]; then
            log_erro "Falha ao aplicar patch $patch_id. OPatch exit: $opatch_rc"
            exit 1
        else
            log_ok "Patch $patch_id aplicado."
        fi
    done

    log_info "Lista de patches no ORACLE_HOME apos CPU:"
    sudo -u oracle "$ORACLE_HOME/OPatch/opatch" lspatches 2>/dev/null | tee -a "$LOGFILE" || true
    log_ok "$total patches CPU JUL 2026 aplicados com sucesso."
}

patch_storage_pre() {
