update_globalenv_properties() {
    log_step "Fase 2f - Atualização do .globalEnv.properties"

    # DIFERENCA vs 14.1.2: exige campo JAVA_HOME_1_8 (ausente no 14.1.2)
    # Escrito 3x com sleep 15 — padrao extraido do CPU de producao Getnet
    local globalenv="${ORACLE_HOME}/oui/.globalEnv.properties"
    local content="JAVA_HOME=/usr/java/latest\nJAVA_HOME_1_8=/usr/java/latest\nJVM_64="

    log_info "Escrevendo .globalEnv.properties (3x com sleep 15 — padrao CPU producao)..."
    for i in 1 2 3; do
        sudo -u oracle bash -c "echo -e '${content}' > ${globalenv}"
        log_info "  Escrita $i/3 concluida."
        [ $i -lt 3 ] && sleep 15
    done

    if [ -f "$globalenv" ]; then
        log_ok ".globalEnv.properties atualizado:"
        cat "$globalenv" | tee -a "$LOGFILE"
    else
        log_warn ".globalEnv.properties nao encontrado: $globalenv"
    fi

    log_info "Validando JDK em oracle_common/jdk:"
    if [ -x "${ORACLE_HOME}/oracle_common/jdk/bin/java" ]; then
        "${ORACLE_HOME}/oracle_common/jdk/bin/java" -version 2>&1 | tee -a "$LOGFILE"
    fi
}

aplicar_patches() {
    log_step "Fase 2 - CPU JUL 2026 OHS 12.2.1.4 (sequência completa)"

    log_info "Verificando processos OHS/NM..."
    local procs_ativos
    procs_ativos=$(ps -ef | grep -E "java|httpd" | grep -v grep | tee -a "$LOGFILE" || true)
    echo ""

    # Em fresh install (ORACLE_HOME/ohs/bin/launch ainda nao existe) nao ha servicos rodando
    if [ ! -f "${ORACLE_HOME}/ohs/bin/launch" ]; then
        log_info "Fresh install detectado — nenhum servico OHS ativo. Prosseguindo."
    else
        if [ -n "$procs_ativos" ]; then
            read -rp "  Os serviços OHS e NodeManager estão down? (s/n): " services_status
            if [[ "$services_status" != "s" && "$services_status" != "S" ]]; then
                log_erro "Para prosseguir os serviços precisam estar down."
                exit 1
            fi
        else
            log_info "Nenhum processo OHS/Java ativo detectado. Prosseguindo."
        fi
    fi

    patch_storage_pre
    baixar_pacote_psu
    _update_java_cpu
    upgrade_opatch
    aplicar_patches_ohs
    patch_storage_final
    update_globalenv_properties
    _upgrade_oracle_common_jdk

    log_info "Patches aplicados no ORACLE_HOME:"
    sudo -u oracle "$ORACLE_HOME/OPatch/opatch" lspatches 2>/dev/null | tee -a "$LOGFILE" || true
    log_ok "CPU OHS 12.2.1.4 JUL 2026 concluido com sucesso."
}

# ─── GERAR domain.py (WLST offline) ──────────────────────────────────────────

gerar_domain_py() {
    local rsp_dir="${MIDIAS}/response"
    local domain_py="${rsp_dir}/ohs12214_domain.py"

    mkdir -p "$rsp_dir"

    cat > "$domain_py" << 'PYEOF'
# -*- coding: utf-8 -*-
# =============================================================================
# ohs12214_domain.py - Domain OHS 12.2.1.4 Standalone
# Ref: Oracle Doc "wtins/configuring-standalone-domain"
#
# Template WLST: 'Oracle HTTP Server (Standalone)' — confirmado em GNCASNPL00154 (prod 12.2.1.4)
#
# Listen Address: doc Oracle recomenda IP real do host, nao localhost.
#   Este script usa string vazia (bind em todas as interfaces) — ajustar se necessario.
# =============================================================================

import os, sys

ORACLE_HOME      = '@@ORACLE_HOME@@'
DOMAIN_HOME      = '@@DOMAIN_HOME@@'
DOMAIN_NAME      = '@@DOMAIN_NAME@@'
JAVA_HOME        = '@@JAVA_HOME@@'
NM_USER          = '@@NM_USER@@'
NM_PASS          = '@@NM_PASS@@'
NM_PORT          = @@NM_PORT@@
OHS_INSTANCE     = '@@OHS_INSTANCE@@'
OHS_LISTEN_PORT  = @@OHS_LISTEN_PORT@@
OHS_SSL_PORT     = @@OHS_SSL_PORT@@
HOST_NAME        = '@@HOST_NAME@@'
MACHINE_NAME     = '@@MACHINE_NAME@@'

def createOHSDomain():
    print('================================================')
    print(' Criando OHS 12.2.1.4 Standalone Domain - WLST')
    print(' Domain  : ' + DOMAIN_NAME)
    print(' Home    : ' + DOMAIN_HOME)
    print(' OHS Inst: ' + OHS_INSTANCE)
    print('================================================')

    setTopologyProfile('Compact')

    print('Selecionando template Oracle HTTP Server (Standalone)...')
    selectTemplate('Oracle HTTP Server (Standalone)')
    loadTemplates()
    print('Templates carregados.')

    setOption('DomainName',      DOMAIN_NAME)
    setOption('JavaHome',        JAVA_HOME)
    setOption('AppDir',          DOMAIN_HOME + '/applications')
    setOption('OverwriteDomain', 'true')
    setOption('ServerStartMode', 'prod')

    print('Configurando SystemComponent: ' + OHS_INSTANCE)
    cd('/')
    # O template Oracle HTTP Server (Standalone) cria ohs1 por padrao em loadTemplates().
    # Se o nome da instancia for diferente de ohs1, remove o default e cria o solicitado.
    # Se for ohs1 (default), apenas navega — criar de novo gera erro 64015 (duplicado).
    if OHS_INSTANCE != 'ohs1':
        try:
            delete('ohs1', 'SystemComponent')
        except:
            pass
        create(OHS_INSTANCE, 'SystemComponent')
    cd('SystemComponent/' + OHS_INSTANCE)
    set('ComponentType', 'OHS')

    # OHS MBean (12.2.1.4 e 14.1.2) espera STRING para ListenPort/SSLListenPort.
    # int() causa "argument type mismatch" — confirmado em QA 20/07/2026.
    print('Configurando OHS: porta HTTP=' + str(OHS_LISTEN_PORT) + ' / SSL=' + str(OHS_SSL_PORT))
    cd('/')
    cd('OHS/' + OHS_INSTANCE)
    set('ListenAddress', '')
    set('ListenPort', str(OHS_LISTEN_PORT))
    set('SSLListenPort', str(OHS_SSL_PORT))
    set('ServerName', 'http://' + HOST_NAME + ':' + str(OHS_LISTEN_PORT))

    print('Configurando NodeManager (PerDomain)...')
    cd('/')
    create('sc', 'SecurityConfiguration')
    cd('SecurityConfiguration/sc')
    set('NodeManagerUsername', NM_USER)
    set('NodeManagerPasswordEncrypted', NM_PASS)
    setOption('NodeManagerType', 'PerDomainNodeManager')

    print('Configurando Machine: ' + MACHINE_NAME)
    cd('/')
    # Template tambem cria Machine 'localmachine' por padrao — mesmo padrao do SystemComponent.
    if MACHINE_NAME != 'localmachine':
        try:
            delete('localmachine', 'Machine')
        except:
            pass
        create(MACHINE_NAME, 'Machine')
    cd('Machine/' + MACHINE_NAME)
    # NodeManager dentro da Machine pode ja existir no template — proteger com try/except.
    try:
        create(MACHINE_NAME, 'NodeManager')
    except:
        pass
    cd('NodeManager/' + MACHINE_NAME)
    set('ListenAddress', 'localhost')
    set('ListenPort', int(NM_PORT))
    set('NMType', 'SSL')

    print('Atrelando ' + OHS_INSTANCE + ' a machine ' + MACHINE_NAME)
    cd('/')
    cd('SystemComponent/' + OHS_INSTANCE)
    set('Machine', MACHINE_NAME)

    print('Gravando domain em: ' + DOMAIN_HOME)
    writeDomain(DOMAIN_HOME)
    closeTemplate()
    print('================================================')
    print(' OHS Domain 12.2.1.4 criado com sucesso!')
    print(' Domain Home: ' + DOMAIN_HOME)
    print(' OHS HTTP   : http://' + HOST_NAME + ':' + str(OHS_LISTEN_PORT))
    print(' OHS SSL    : https://' + HOST_NAME + ':' + str(OHS_SSL_PORT))
    print('================================================')

createOHSDomain()
PYEOF

    sed -i "s|@@ORACLE_HOME@@|${ORACLE_HOME}|g"         "$domain_py"
    sed -i "s|@@DOMAIN_HOME@@|${DOMAIN_HOME}|g"         "$domain_py"
    sed -i "s|@@DOMAIN_NAME@@|${DOMAIN_NAME}|g"         "$domain_py"
    sed -i "s|@@JAVA_HOME@@|${JAVA_HOME_PATH:-$JAVA_HOME_8A}|g" "$domain_py"
    sed -i "s|@@NM_USER@@|${WLS_ADMIN_USER}|g"          "$domain_py"
    sed -i "s|@@NM_PASS@@|${WLS_ADMIN_PASS}|g"          "$domain_py"
    sed -i "s|@@NM_PORT@@|${NM_PORT}|g"                 "$domain_py"
    sed -i "s|@@OHS_INSTANCE@@|${OHS_INSTANCE}|g"       "$domain_py"
    sed -i "s|@@OHS_LISTEN_PORT@@|${OHS_LISTEN_PORT}|g" "$domain_py"
    sed -i "s|@@OHS_SSL_PORT@@|${OHS_SSL_PORT}|g"       "$domain_py"
    sed -i "s|@@HOST_NAME@@|${HOST_FQDN}|g"             "$domain_py"
    sed -i "s|@@MACHINE_NAME@@|${MACHINE_NAME}|g"       "$domain_py"

    chown ${ORACLE_USER}:${ORACLE_GROUP} "$domain_py"
    chmod 640 "$domain_py"
    log_ok "domain.py gerado: $domain_py"
}

# ─── CRIAR DOMÍNIO ───────────────────────────────────────────────────────────

criar_domain() {
    log_step "Fase 3 - Criação do Domain OHS 12.2.1.4 Standalone (WLST offline)"

    gerar_domain_py

    local wlst="${ORACLE_HOME}/oracle_common/common/bin/wlst.sh"
    local domain_py="${MIDIAS}/response/ohs12214_domain.py"

    [ ! -f "$wlst" ] && { log_erro "WLST nao encontrado: $wlst"; exit 1; }

    mkdir -p "$DOMAIN_HOME"
    chown -R ${ORACLE_USER}:${ORACLE_GROUP} "$(dirname "$DOMAIN_HOME")" 2>/dev/null || true

    if [ -f "${DOMAIN_HOME}/config/config.xml" ]; then
        log_warn "Domain ja existe em ${DOMAIN_HOME}."
        read -rp "  Deseja recriar? ATENCAO: apaga config atual (s/n): " recriar_dm
        if [[ "$recriar_dm" != "s" ]]; then
            log_info "Domain mantido. Pulando criacao."
            return 0
        fi
        rm -rf "${DOMAIN_HOME}"/*
    fi

    log_info "Executando WLST offline para criar domain OHS 12.2.1.4..."
    sudo -u oracle bash -c "
        export JAVA_HOME=${JAVA_HOME_PATH:-$JAVA_HOME_8A}
        export PATH=\$JAVA_HOME/bin:\$PATH
        '${wlst}' '${domain_py}'
    " 2>&1 | tee -a "$LOGFILE"
    checar_erro "Falha na criacao do domain OHS."

    chown -R ${ORACLE_USER}:${ORACLE_GROUP} "$DOMAIN_HOME"
    chmod -R 750 "$DOMAIN_HOME"

    local java_home_val="${JAVA_HOME_PATH:-$JAVA_HOME_8A}"

    local set_nm_java="${DOMAIN_HOME}/bin/setNMJavaHome.sh"
    if [ -f "$set_nm_java" ]; then
        sudo -u oracle sed -i "s|JAVA_HOME=.*|JAVA_HOME=${java_home_val}|g" "$set_nm_java"
        log_ok "setNMJavaHome.sh atualizado: JAVA_HOME=${java_home_val}"
    fi

    local nm_props="${DOMAIN_HOME}/nodemanager/nodemanager.properties"
    if [ -f "$nm_props" ]; then
        sudo -u oracle sed -i "s|^JavaHome=.*|JavaHome=${java_home_val}|" "$nm_props"
        log_ok "nodemanager.properties atualizado: JavaHome=${java_home_val}"
    fi

    log_ok "Domain OHS 12.2.1.4 criado: $DOMAIN_HOME"
}

# ─── INICIAR NODE MANAGER + OHS INSTANCE ─────────────────────────────────────

iniciar_servicos() {
    log_step "Fase 4 - Iniciando NodeManager e Instância OHS 12.2.1.4"

    local nm_home="${DOMAIN_HOME}/nodemanager"
    mkdir -p "$nm_home"
    chown -R oracle:oinstall "$nm_home"

    local java_home_val="${JAVA_HOME_PATH:-$JAVA_HOME_8A}"

    log_info "Iniciando NodeManager (background, como oracle)..."
    sudo -u oracle bash -c "
        export JAVA_HOME=${java_home_val}
        export PATH=\$JAVA_HOME/bin:\$PATH
        export ORACLE_HOME=${ORACLE_HOME}
        cd ${DOMAIN_HOME}/bin
        nohup ./startNodeManager.sh > ${nm_home}/nodemanager.out 2>&1 &
        echo \$! > ${nm_home}/nodemanager.pid
        echo 'NodeManager PID '\$!
    "
    sleep 15

    if timeout 5 bash -c "echo >/dev/tcp/localhost/${NM_PORT}" 2>/dev/null; then
        log_ok "NodeManager respondendo na porta ${NM_PORT}."
    else
        log_warn "NodeManager pode ainda estar iniciando. Aguardando mais 15s..."
        sleep 15
    fi

    # Criar estrutura de dirs que o OHS exige antes do startComponent.sh
    # (ausencia causa "No such file or directory" no startup.out e OHS nao sobe)
    log_info "Criando estrutura de diretorios OHS (logs/data/.inventory/tmp)..."
    mkdir -p "${DOMAIN_HOME}/servers/${OHS_INSTANCE}"/{logs,data/.inventory,tmp}
    chown -R oracle:oinstall "${DOMAIN_HOME}/servers/"
    chmod -R 750 "${DOMAIN_HOME}/servers/"
    log_ok "Estrutura de diretorios criada."

    # Injetar User/Group no httpd.conf — master E runtime
    # NodeManager sincroniza master→runtime no primeiro start; injetar nos dois para garantir.
    # Sem essas diretivas o Apache sobe inteiramente como root (bind na porta 80 funciona
    # via suid no launch, mas nao ha drop de privilegio para os workers).
    local httpd_master="${DOMAIN_HOME}/config/fmwconfig/components/OHS/${OHS_INSTANCE}/httpd.conf"
    local httpd_runtime="${DOMAIN_HOME}/config/fmwconfig/components/OHS/instances/${OHS_INSTANCE}/httpd.conf"
    for httpd_conf in "$httpd_master" "$httpd_runtime"; do
        if [ -f "$httpd_conf" ]; then
            if grep -qE "^User oracle" "$httpd_conf"; then
                log_ok "User/Group ja presente em: $(basename $(dirname $httpd_conf))/httpd.conf"
            else
                printf '\nUser oracle\nGroup oinstall\n' >> "$httpd_conf"
                log_ok "User oracle / Group oinstall injetado em: $httpd_conf"
            fi
        else
            log_warn "httpd.conf nao encontrado: $httpd_conf"
        fi
    done

    # Armazenar credenciais NM (metodo nativo Oracle — igual ao 14.1.2)
    # Grava ~/.wlst/nm-cfg-<domain>.props e nm-key-<domain>.props
    # Apos storeUserConfig, startComponent/stopComponent funcionam sem prompt de senha.
    log_info "Armazenando credenciais NM via storeUserConfig..."
    sudo -u oracle bash -c "
        export JAVA_HOME=${java_home_val}
        export PATH=\$JAVA_HOME/bin:\$PATH
        export ORACLE_HOME=${ORACLE_HOME}
        cd ${DOMAIN_HOME}/bin
        echo '${WLS_ADMIN_PASS}' | ./startComponent.sh ${OHS_INSTANCE} storeUserConfig
    " 2>&1 | tee -a "$LOGFILE" || log_warn "storeUserConfig com aviso (continuando)..."

    log_info "Iniciando instancia OHS ${OHS_INSTANCE} via startComponent.sh..."
    sudo -u oracle bash -c "
        export JAVA_HOME=${java_home_val}
        export PATH=\$JAVA_HOME/bin:\$PATH
        export ORACLE_HOME=${ORACLE_HOME}
        cd ${DOMAIN_HOME}/bin
        ./startComponent.sh ${OHS_INSTANCE} \
            >> ${DOMAIN_HOME}/servers/${OHS_INSTANCE}/logs/startup.out 2>&1
    " 2>&1 | tee -a "$LOGFILE" || log_warn "startComponent.sh com aviso (continuando)..."

    sleep 20

    if timeout 5 bash -c "echo >/dev/tcp/localhost/${OHS_LISTEN_PORT}" 2>/dev/null; then
        log_ok "OHS respondendo na porta HTTP ${OHS_LISTEN_PORT}."
    else
        log_warn "OHS pode ainda estar iniciando. Aguardando mais 30s..."
        sleep 30
        if timeout 5 bash -c "echo >/dev/tcp/localhost/${OHS_LISTEN_PORT}" 2>/dev/null; then
            log_ok "OHS respondendo na porta HTTP ${OHS_LISTEN_PORT}."
        else
            log_warn "OHS nao respondeu. Veja: tail -f ${DOMAIN_HOME}/system_components/OHS/ohs_nm.log"
        fi
    fi

    log_ok "  NodeManager : tail -f ${DOMAIN_HOME}/nodemanager/nodemanager.log"
    log_ok "  OHS Log     : tail -f ${DOMAIN_HOME}/servers/${OHS_INSTANCE}/logs/${OHS_INSTANCE}.log"
    log_ok "  OHS HTTP    : http://${HOST_FQDN}:${OHS_LISTEN_PORT}"
    log_ok "  OHS SSL     : https://${HOST_FQDN}:${OHS_SSL_PORT}"
}

# ─── ROOT.SH POS-INSTALL ─────────────────────────────────────────────────────

rodar_root_sh() {
    if [ -f "$ORACLE_HOME/root.sh" ]; then
        log_step "Executando root.sh pos-install"
        bash "$ORACLE_HOME/root.sh" 2>&1 | tee -a "$LOGFILE" || true
        log_ok "root.sh executado."
    fi

    # suid: OHS 12.2.1.4 usa 'launch' (sem 's'). 14.1.2 usa 'launchs' (Doc ID 3099700.1).
    # chown root:oinstall + chmod 4750 — mesmo padrao do dbclient 19c (oracle binary).
    local launch_bin="${ORACLE_HOME}/ohs/bin/launch"
    if [ -f "$launch_bin" ]; then
        chown root:${ORACLE_GROUP} "$launch_bin"
        chmod 4750 "$launch_bin"
        log_ok "suid configurado em: $launch_bin (root:${ORACLE_GROUP} 4750)"
    else
        log_warn "Binario $launch_bin nao encontrado — suid nao configurado."
    fi
}

