# ─── VALIDAÇÕES BÁSICAS ──────────────────────────────────────────────────────

validar_root() {
    if [ "$(id -u)" -ne 0 ]; then
        log_erro "Este script deve ser executado como root."
        exit 1
    fi
}

preparar_usuario_oracle() {
    log_step "Verificação / Preparação do Usuário Oracle"

    if ! getent group "$ORACLE_GROUP" &>/dev/null; then
        log_warn "Grupo '$ORACLE_GROUP' não encontrado. Criando..."
        if ! groupadd -g "$ORACLE_GID" "$ORACLE_GROUP" 2>/dev/null; then
            log_warn "GID $ORACLE_GID em uso por outro grupo. Criando $ORACLE_GROUP sem GID fixo..."
            groupadd "$ORACLE_GROUP"
            checar_erro "Falha ao criar grupo $ORACLE_GROUP."
        fi
        if ! getent group "$ORACLE_GROUP" &>/dev/null; then
            log_erro "Grupo $ORACLE_GROUP nao foi criado. Verifique conflito de GID no sistema."
            exit 1
        fi
        local gid_real
        gid_real=$(getent group "$ORACLE_GROUP" | cut -d: -f3)
        ORACLE_GID="$gid_real"
        log_ok "Grupo $ORACLE_GROUP criado (GID: $gid_real)."
    else
        ORACLE_GID=$(getent group "$ORACLE_GROUP" | cut -d: -f3)
        log_ok "Grupo $ORACLE_GROUP já existe (GID: $ORACLE_GID)."
    fi

    if ! id "$ORACLE_USER" &>/dev/null; then
        log_warn "Usuário '$ORACLE_USER' não encontrado. Criando..."
        mkdir -p "$ORACLE_USER_HOME"
        useradd -u "$ORACLE_UID" -g "$ORACLE_GROUP" -G "$ORACLE_GROUP" \
                -d "$ORACLE_USER_HOME" -s /bin/bash \
                -c "Oracle Software Owner" "$ORACLE_USER"
        checar_erro "Falha ao criar usuario $ORACLE_USER."
        log_ok "Usuário oracle criado (UID: $ORACLE_UID | Home: $ORACLE_USER_HOME)."

        log_info "Informe a senha do oracle gerada pelo Playbook/CyberArk:"
        read -rsp "  Senha oracle (CyberArk): " ORACLE_OS_PASS; echo ""
        [[ -z "$ORACLE_OS_PASS" ]] && { log_erro "Senha não pode ser vazia."; exit 1; }
        echo "${ORACLE_USER}:${ORACLE_OS_PASS}" | chpasswd
        log_ok "Senha do oracle definida no host."
    else
        log_ok "Usuário oracle já existe: $(id oracle)"
        read -rp "  Deseja (re)definir a senha do oracle com a do Playbook/CyberArk? (s/n): " redef
        if [[ "$redef" == "s" ]]; then
            read -rsp "  Senha oracle (CyberArk): " ORACLE_OS_PASS; echo ""
            [[ -z "$ORACLE_OS_PASS" ]] && { log_erro "Senha não pode ser vazia."; exit 1; }
            echo "${ORACLE_USER}:${ORACLE_OS_PASS}" | chpasswd
            log_ok "Senha do oracle (re)definida com sucesso."
        else
            log_info "Senha mantida. Continuando..."
        fi
    fi

    [ ! -d "$ORACLE_USER_HOME" ] && mkdir -p "$ORACLE_USER_HOME"
    chown oracle:oinstall "$ORACLE_USER_HOME"
    chmod 750 "$ORACLE_USER_HOME"

    for dir in "$ORACLE_BASE" "$ORACLE_BASE/middleware" "$INVENTORY"; do
        [ ! -d "$dir" ] && mkdir -p "$dir"
        chown -R oracle:oinstall "$dir"
    done

    local profile="${ORACLE_USER_HOME}/.bash_profile"
    if [ ! -f "$profile" ]; then
        cat > "$profile" << EOF
# Oracle bash_profile - gerado por INSTALL_OHS_12214_STANDALONE.sh
export ORACLE_BASE=${ORACLE_BASE}
export ORACLE_HOME=${ORACLE_HOME_PADRAO}
export PATH=\$ORACLE_HOME/bin:\$ORACLE_HOME/OPatch:\$PATH
export JAVA_HOME=${JAVA_HOME_8A}
export PATH=\$JAVA_HOME/bin:\$PATH
[ -f ~/.bashrc ] && . ~/.bashrc
EOF
        chown oracle:oinstall "$profile"
        log_ok ".bash_profile do oracle criado."
    fi

    local bashrc="${ORACLE_USER_HOME}/.bashrc"
    if [ ! -f "$bashrc" ] || ! grep -q "PS1" "$bashrc" 2>/dev/null; then
        cat >> "$bashrc" << 'EOF'
# Prompt colorido — gerado por INSTALL_OHS_12214_STANDALONE.sh
export PS1='[\[\033[0;32m\]\u\[\033[0m\]@\[\033[0;36m\]\h\[\033[0m\] \W]\$ '
EOF
        chown oracle:oinstall "$bashrc"
        log_ok ".bashrc do oracle configurado (PS1 com usuario e diretorio)."
    fi

    log_ok "Usuário oracle pronto para instalação."
}

instalar_prereqs_so() {
    log_step "Pre-requisitos SO — pacotes necessarios para OHS 12.2.1.4 em RHEL 8"
    # compat-libcap1 e compat-libstdc++-33 sao RHEL 7 — nao existem no RHEL 8.
    # O installer usa -ignoreSysPrereqs para ignora-los (substituidos por versoes mais novas).
    # libnsl: obrigatorio no RHEL 8 — OHS 12.2.1.4 foi compilado para RHEL 7 onde libnsl.so.1
    # vinha no glibc. No RHEL 8 e pacote separado; sem ele httpd aborta com "cannot open shared object".
    local pkgs="binutils gcc gcc-c++ glibc-devel libstdc++-devel libaio-devel sysstat ksh libnsl"
    log_info "Instalando: $pkgs"
    dnf install -y $pkgs 2>&1 | tee -a "$LOGFILE" || \
        log_warn "Alguns pacotes podem ja estar instalados ou indisponiveis no repo."
    log_ok "Pre-requisitos SO verificados."
}

validar_espaco_disco() {
    local path="$1"
    local minimo_gb="$2"
    local disponivel
    disponivel=$(df -BG "$path" 2>/dev/null | awk 'NR==2{gsub("G",""); print $4}')
    if [ -z "$disponivel" ] || [ "$disponivel" -lt "$minimo_gb" ]; then
        log_warn "Espaço disponível em $path: ${disponivel}GB (mínimo recomendado: ${minimo_gb}GB)"
        read -rp "  Deseja continuar mesmo assim? (s/n): " cont
        [[ "$cont" != "s" ]] && exit 1
    else
        log_ok "Espaço em $path: ${disponivel}GB disponível."
    fi
}

criar_orainst() {
    log_step "Criando oraInst.loc e inventory"
    if [ -f "$ORAINST" ]; then
        log_warn "$ORAINST já existe. Conteúdo atual:"
        cat "$ORAINST"
        read -rp "  Deseja recriar? (s/n): " recria
        [[ "$recria" != "s" ]] && return 0
    fi

    mkdir -p "$INVENTORY"
    chown -R ${ORACLE_USER}:${ORACLE_GROUP} "$INVENTORY"

    cat > "$ORAINST" << EOF
inventory_loc=${INVENTORY}
inst_group=${ORACLE_GROUP}
EOF
    chmod 644 "$ORAINST"
    log_ok "oraInst.loc criado em $ORAINST"
}

