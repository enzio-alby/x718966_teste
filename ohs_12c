# ─── MENU PRINCIPAL ──────────────────────────────────────────────────────────

menu_principal() {
    banner
    echo -e "  ${BOLD}O que deseja fazer?${NC}"
    echo ""
    echo "  [1] Instalação completa      (Java + Download + OHS + CPU + Domain + Start)"
    echo "  [2] Instalar Java 8 SO       (apenas JDK 8)"
    echo "  [3] Download + Instalar OHS  (baixar zip do repo e instalar OHS standalone)"
    echo "  [4] Aplicar CPU JUL 2026     (14 patches + Java + oracle_common/jdk)"
    echo "  [5] Criar domain OHS         (Config Wizard via WLST offline)"
    echo "  [6] Iniciar servicos         (NodeManager + Instancia OHS)"
    echo "  [7] Gerar response file      (Apenas resumo final)"
    echo "  [0] Sair"
    echo ""
    read -rp "  Escolha uma opção: " opcao
    echo ""

    case "$opcao" in
        1)
            coletar_infos_gerais
            validar_espaco_disco "/u01" 10
            validar_espaco_disco "/u02" 5
            instalar_prereqs_so
            instalar_java
            baixar_instaladores
            instalar_binarios
            aplicar_patches
            criar_domain
            rodar_root_sh
            iniciar_servicos
            gerar_response_final
            service qualys-cloud-agent restart 2>/dev/null || true
            ;;
        2)
            instalar_java
            ;;
        3)
            [ -z "$ORACLE_HOME" ] && read -rp "  ORACLE_HOME [${ORACLE_HOME_PADRAO}]: " inp && ORACLE_HOME="${inp:-$ORACLE_HOME_PADRAO}"
            [ -z "$JAVA_HOME_PATH" ] && JAVA_HOME_PATH="$JAVA_HOME_8A"
            baixar_instaladores
            instalar_binarios
            log_ok "OHS instalado. Execute [4] para CPU e [5] para criar domain."
            ;;
        4)
            [ -z "$ORACLE_HOME" ] && read -rp "  ORACLE_HOME [${ORACLE_HOME_PADRAO}]: " inp && ORACLE_HOME="${inp:-$ORACLE_HOME_PADRAO}"
            [ -z "$JAVA_HOME_PATH" ] && JAVA_HOME_PATH="$JAVA_HOME_8A"
            export ORACLE_HOME
            aplicar_patches
            rodar_root_sh
            service qualys-cloud-agent restart 2>/dev/null || true
            ;;
        5)
            [ -z "$ORACLE_HOME" ]     && read -rp "  ORACLE_HOME [${ORACLE_HOME_PADRAO}]: " inp && ORACLE_HOME="${inp:-$ORACLE_HOME_PADRAO}"
            [ -z "$JAVA_HOME_PATH" ]  && JAVA_HOME_PATH="$JAVA_HOME_8A"
            [ -z "$DOMAIN_HOME" ]     && { read -rp "  DOMAIN_HOME [${DOMAIN_PARENT_PADRAO}/${DOMAIN_NAME_PADRAO}]: " inp; DOMAIN_HOME="${inp:-${DOMAIN_PARENT_PADRAO}/${DOMAIN_NAME_PADRAO}}"; DOMAIN_NAME=$(basename "$DOMAIN_HOME"); }
            [ -z "$OHS_INSTANCE" ]    && { read -rp "  Instancia OHS [${OHS_INSTANCE_PADRAO}]: " inp; OHS_INSTANCE="${inp:-$OHS_INSTANCE_PADRAO}"; }
            [ -z "$OHS_LISTEN_PORT" ] && { read -rp "  Porta HTTP [${OHS_LISTEN_PORT_PADRAO}]: " inp; OHS_LISTEN_PORT="${inp:-$OHS_LISTEN_PORT_PADRAO}"; }
            [ -z "$OHS_SSL_PORT" ]    && { read -rp "  Porta SSL [${OHS_SSL_PORT_PADRAO}]: " inp; OHS_SSL_PORT="${inp:-$OHS_SSL_PORT_PADRAO}"; }

            if [ -z "$WLS_ADMIN_PASS" ]; then
                local sf="${MIDIAS}/response/ohs12214_admin_pass.txt"
                if [ -f "$sf" ]; then
                    WLS_ADMIN_PASS=$(grep "WLS_ADMIN_PASS=" "$sf" | cut -d= -f2)
                    log_info "Senha carregada de: $sf"
                else
                    WLS_ADMIN_PASS=$(cat /dev/urandom | tr -dc 'A-Za-z0-9' | head -c 14)
                    WLS_ADMIN_PASS="${WLS_ADMIN_PASS}#1"
                    mkdir -p "${MIDIAS}/response"
                    { echo "WLS_ADMIN_USER=${WLS_ADMIN_USER}"; echo "WLS_ADMIN_PASS=${WLS_ADMIN_PASS}"; \
                      echo "HOST=${HOST_NAME}"; echo "GERADO_EM=$(date '+%d/%m/%Y %H:%M:%S')"; } > "$sf"
                    chmod 600 "$sf"
                fi
            fi

            criar_domain
            rodar_root_sh
            iniciar_servicos
            gerar_response_final
            ;;
        6)
            [ -z "$ORACLE_HOME" ]     && read -rp "  ORACLE_HOME [${ORACLE_HOME_PADRAO}]: " inp && ORACLE_HOME="${inp:-$ORACLE_HOME_PADRAO}"
            [ -z "$DOMAIN_HOME" ]     && read -rp "  DOMAIN_HOME: " DOMAIN_HOME
            [ -z "$OHS_INSTANCE" ]    && { read -rp "  Instancia OHS [${OHS_INSTANCE_PADRAO}]: " inp; OHS_INSTANCE="${inp:-$OHS_INSTANCE_PADRAO}"; }
            [ -z "$JAVA_HOME_PATH" ]  && JAVA_HOME_PATH="$JAVA_HOME_8A"
            [ -z "$OHS_LISTEN_PORT" ] && OHS_LISTEN_PORT="$OHS_LISTEN_PORT_PADRAO"
            [ -z "$OHS_SSL_PORT" ]    && OHS_SSL_PORT="$OHS_SSL_PORT_PADRAO"
            [ -z "$WLS_ADMIN_PASS" ]  && {
                local sf="${MIDIAS}/response/ohs12214_admin_pass.txt"
                [ -f "$sf" ] && WLS_ADMIN_PASS=$(grep "WLS_ADMIN_PASS=" "$sf" | cut -d= -f2)
            }
            iniciar_servicos
            ;;
        7)
            [ -z "$ORACLE_HOME" ]     && read -rp "  ORACLE_HOME: " ORACLE_HOME
            [ -z "$DOMAIN_HOME" ]     && read -rp "  DOMAIN_HOME: " DOMAIN_HOME && DOMAIN_NAME=$(basename "$DOMAIN_HOME")
            [ -z "$OHS_INSTANCE" ]    && OHS_INSTANCE="$OHS_INSTANCE_PADRAO"
            [ -z "$OHS_LISTEN_PORT" ] && OHS_LISTEN_PORT="$OHS_LISTEN_PORT_PADRAO"
            [ -z "$OHS_SSL_PORT" ]    && OHS_SSL_PORT="$OHS_SSL_PORT_PADRAO"
            [ -z "$EQUIPE" ]          && EQUIPE="N/A"
            [ -z "$JAVA_HOME_PATH" ]  && JAVA_HOME_PATH="$JAVA_HOME_8A"
            gerar_response_final
            ;;
        0) log_info "Saindo."; exit 0 ;;
        *) log_erro "Opção inválida."; menu_principal ;;
    esac

    echo ""
    read -rp "  Deseja executar outra opção? (s/n): " rep
    [[ "$rep" == "s" ]] && menu_principal
}

