#!/bin/bash
# =============================================================================
# INSTALAÇÃO Oracle HTTP Server (OHS) 12.2.1.4 STANDALONE
# Oraex / Getnet - Ambiente QA / HML / PRD
#
# Baseado em:
#   - Doc Oracle "Installing and Configuring Oracle HTTP Server 12.2.1.4"
#     (wtins/installing-product-software + wtins/configuring-standalone-domain)
#   - INSTALL_OHS_1412_STANDALONE.sh (referencia de estrutura)
#   - OHS_12214_JUL26.sh (CPU JUL 2026 producao Getnet - Fase 2 integrada)
#
# Topologia: STANDALONE (OH proprio, sem FMW Infrastructure / sem WLS)
#   Confirmado pela doc Oracle: standalone pode ser instalado e configurado
#   SEM o Oracle Fusion Middleware Infrastructure JAR.
#   O proprio installer OHS cria oracle_common com WLST e config.sh.
#
# Diferencas criticas vs 14.1.2:
#   - JDK 8 obrigatorio (nao JDK 17/21)
#   - java.security em jre/lib/security/ (nao conf/security/)
#   - oracle_common/jdk precisa de upgrade manual pos-install
#   - .globalEnv.properties exige JAVA_HOME_1_8 (campo extra vs 14.1.2)
#   - 14 patches CPU (vs 13 no 14.1.2)
#   - Instalador: fmw_12.2.1.4.0_ohs_linux64.bin (extraido do Disk1_1of1.zip)
#   - suid: chown root:oinstall + chmod 4750 em ohs/bin/launch (confirmado 12.2.1.4)
#
# Autor: Oraex | Atualizado: Julho/2026
# USO: ./INSTALL_OHS_12214_STANDALONE.sh
# Deve ser executado como root. Operacoes Oracle rodam como sudo -u oracle.
# =============================================================================

set -uo pipefail

# ─── CORES E LOG ─────────────────────────────────────────────────────────────

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

HOST_NAME=$(hostname -s)
HOST_FQDN=$(hostname -f 2>/dev/null || hostname)
HOST_IP=$(hostname -I | awk '{print $1}')

LOGDIR="/u02/midias/logs"
mkdir -p "$LOGDIR"
LOGFILE="$LOGDIR/install_ohs12214_${HOST_NAME}.log"
echo ""                                                         >> "$LOGFILE" 2>/dev/null || true
echo "======================================================================" >> "$LOGFILE" 2>/dev/null || true
echo "  NOVA EXECUCAO: $(date '+%d/%m/%Y %H:%M:%S')"           >> "$LOGFILE" 2>/dev/null || true
echo "======================================================================" >> "$LOGFILE" 2>/dev/null || true

log_info()  { echo -e "${CYAN}[INFO]${NC}  $*" | tee -a "$LOGFILE"; }
log_ok()    { echo -e "${GREEN}[OK]${NC}    $*" | tee -a "$LOGFILE"; }
log_warn()  { echo -e "${YELLOW}[WARN]${NC}  $*" | tee -a "$LOGFILE"; }
log_erro()  { echo -e "${RED}[ERRO]${NC}  $*" | tee -a "$LOGFILE"; }
log_step()  { echo -e "\n${BOLD}${BLUE}════════════════════════════════════════════════════════════════${NC}"; \
              echo -e "${BOLD}${BLUE}  $*${NC}"; \
              echo -e "${BOLD}${BLUE}════════════════════════════════════════════════════════════════${NC}\n" | tee -a "$LOGFILE"; }

checar_erro() {
    if [ $? -ne 0 ]; then
        log_erro "$1"
        log_erro "Verifique o log: $LOGFILE"
        exit 1
    fi
}

