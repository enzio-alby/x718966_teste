    sudo -u oracle tar -zcf "$ORACLE_HOME/patch_storage.tar.gz" -C "$ORACLE_HOME" .patch_storage/ 2>/dev/null || true
    sudo -u oracle rm -rf "$ORACLE_HOME/.patch_storage/"* 2>/dev/null || true
