    cd "$ORACLE_HOME" || { log_erro "Não foi possível acessar $ORACLE_HOME"; return 1; }

    local tar_file
    tar_file=$(find . -maxdepth 1 -name "patch_storage.tar.gz" -print -quit 2>/dev/null)

    if [ -z "$tar_file" ]; then
        log_info "Nenhum patch_storage.tar.gz encontrado. Pulando."
